<?xml version="1.0"?>
<robot name="parallel_jaw">
<link name="palm">
<inertial><mass value="0.1"/><inertia ixx=".0001" iyy=".0001" izz=".0001" ixy="0" ixz="0" iyz="0"/></inertial>
<visual><origin xyz="0 0 .06"/><geometry><box size=".03 .10 .025"/></geometry><material name="grey"><color rgba=".25 .3 .35 1"/></material></visual>
<collision><origin xyz="0 0 .06"/><geometry><box size=".03 .10 .025"/></geometry></collision>
</link>

<link name="left">
<inertial><mass value=".02"/><inertia ixx=".00001" iyy=".00001" izz=".00001" ixy="0" ixz="0" iyz="0"/></inertial>
<visual><origin xyz="0 0 .115"/><geometry><box size=".018 .006 .04"/></geometry><material name="finger"><color rgba=".65 .7 .75 1"/></material></visual>
<collision><origin xyz="0 0 .115"/><geometry><box size=".018 .006 .04"/></geometry></collision>
</link>
<joint name="left_slide" type="prismatic"><parent link="palm"/><child link="left"/><origin xyz="0 0.003 0"/><axis xyz="0 1 0"/><limit lower="0" upper=".045" effort="20" velocity=".1"/></joint>

<link name="right">
<inertial><mass value=".02"/><inertia ixx=".00001" iyy=".00001" izz=".00001" ixy="0" ixz="0" iyz="0"/></inertial>
<visual><origin xyz="0 0 .115"/><geometry><box size=".018 .006 .04"/></geometry><material name="finger"><color rgba=".65 .7 .75 1"/></material></visual>
<collision><origin xyz="0 0 .115"/><geometry><box size=".018 .006 .04"/></geometry></collision>
</link>
<joint name="right_slide" type="prismatic"><parent link="palm"/><child link="right"/><origin xyz="0 -0.003 0"/><axis xyz="0 -1 0"/><limit lower="0" upper=".045" effort="20" velocity=".1"/></joint>
</robot>
